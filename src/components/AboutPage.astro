---
import Layout from "../layouts/Layout.astro";
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import { getRoutePath, useTranslations, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang }: Props = Astro.props;
const t = useTranslations(lang);
---

<Layout
  lang={lang}
  title={t.meta.aboutTitle}
  description={t.meta.aboutDescription}
>
  <Section class="pt-28 pb-24 min-h-[80vh]">
    <SectionHeader
      as="h1"
      eyebrow={t.about.eyebrow}
      title={t.about.title}
      highlight={t.about.highlight}
      description={t.about.subtitle}
      backHref={getRoutePath(lang, "home")}
      backLabel={t.about.backHome}
    />

    <!-- Bio + Photo -->
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center"
    >
      <div class="lg:col-span-5 flex flex-col items-center lg:items-start">
        <div
          class="w-full max-w-sm rounded-2xl overflow-hidden border border-white/10 bg-white/[0.03] shadow-2xl"
        >
          <img
            src="/profile.webp"
            alt="Adrián Morales"
            width="600"
            height="600"
            loading="lazy"
            decoding="async"
            class="w-full aspect-square object-cover"
          />
        </div>
        <div class="flex flex-wrap gap-2 mt-4">
          <Badge variant="accent" size="sm">
            <Icon name="briefcase" size={14} />
            {t.about.roleLabel}
          </Badge>
          <Badge variant="neutral" size="sm">
            <Icon name="map-pin" size={14} />
            {t.about.locationLabel}
          </Badge>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-6">
        {
          t.about.paragraphs.map((paragraph) => (
            <p class="text-slate-300 text-base md:text-lg leading-relaxed">
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>

    <!-- Focus pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-14">
      {
        t.about.pillars.map((pillar) => (
          <div class="group p-8 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:bg-white/[0.06] hover:border-brand-secondary/30 transition-all duration-300">
            <div class="w-12 h-12 mb-5 flex items-center justify-center rounded-xl bg-brand-secondary/10 text-brand-secondary group-hover:bg-brand-secondary group-hover:text-white transition-colors">
              <Icon name={pillar.iconName} size={24} strokeWidth={1.75} />
            </div>
            <h2 class="text-lg font-bold text-white mb-3 group-hover:text-brand-secondary transition-colors">
              {pillar.title}
            </h2>
            <p class="text-slate-400 text-sm leading-relaxed">
              {pillar.description}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Contact CTA -->
    <div
      class="mt-14 p-8 md:p-10 rounded-2xl bg-white/[0.03] border border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-6"
    >
      <p
        class="text-xl md:text-2xl font-bold text-white text-center sm:text-left"
      >
        {t.about.ctaTitle}
      </p>
      <Button
        href="mailto:moralescrtech@gmail.com"
        variant="primary"
        size="lg"
      >
        <Icon name="mail" size={18} />
        {t.about.ctaButton}
      </Button>
    </div>
  </Section>
</Layout>
