---
interface Props {
  title: string;
  date: string;
  location: string;
  role: string;
  description: string;
  image: string;
  link: string;
}

const { title, date, location, role, description, image, link } = Astro.props;
---

<div class="mb-12 ml-8 md:ml-12 relative group">
  <span
    class="absolute flex items-center justify-center w-8 h-8 bg-brand-secondary/10 rounded-full -left-[48px] md:-left-[64px] ring-8 ring-brand-dark group-hover:bg-brand-secondary transition-colors duration-300"
  >
    <svg
      class="w-4 h-4 text-brand-secondary group-hover:text-white transition-colors"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      fill="currentColor"
      viewBox="0 0 20 20"
    >
      <path
        d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"
      ></path>
    </svg>
  </span>

  <div
    class="bg-white/[0.03] p-6 rounded-2xl border border-white/[0.06] hover:border-brand-secondary/20 hover:bg-white/[0.05] transition-all duration-300"
  >
    <h3
      class="flex items-center mb-2 text-2xl font-bold text-white group-hover:text-brand-secondary transition-colors"
    >
      {title}
    </h3>
    <div class="flex flex-wrap gap-2 mb-4 text-sm font-medium">
      <span
        class="bg-brand-secondary/10 text-brand-secondary border border-brand-secondary/20 px-3 py-1 rounded-full"
      >
        {date}
      </span>
      <span
        class="bg-white/[0.04] text-slate-400 border border-white/[0.08] px-3 py-1 rounded-full"
      >
        {role}
      </span>
      <span
        class="bg-white/[0.04] text-slate-400 border border-white/[0.08] px-3 py-1 rounded-full"
      >
        {location}
      </span>
    </div>
    <p class="mb-4 text-base font-normal text-slate-400 leading-relaxed">
      {description}
    </p>
    {
      image && (
        <div class="mb-6 overflow-hidden rounded-xl border border-white/[0.08]">
          <img
            src={image}
            alt={title}
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover max-h-80 hover:scale-105 transition-transform duration-500"
          />
        </div>
      )
    }
    {
      link !== "#" && link !== "" && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-white/[0.05] border border-white/[0.1] rounded-full hover:bg-brand-secondary/10 hover:text-brand-secondary hover:border-brand-secondary/30 transition-all active:scale-95"
        >
          Learn more
          <svg
            class="w-3.5 h-3.5 ms-2"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 14 10"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M1 5h12m0 0L9 1m4 4L9 9"
            />
          </svg>
        </a>
      )
    }
  </div>
</div>
