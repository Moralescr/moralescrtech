---
import services from "../data/services.json";
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";
import Icon, { type IconName } from "./ui/Icon.astro";
import {
  SECTION_IDS,
  getLangFromUrl,
  useTranslations,
  type Locale,
} from "../i18n";

interface Props {
  lang?: Locale;
}

interface ServiceItem {
  title: Record<Locale, string>;
  description: Record<Locale, string>;
  iconName: IconName;
}

const { lang = getLangFromUrl(Astro.url) }: Props = Astro.props;
const t = useTranslations(lang);
const serviceList = services as ServiceItem[];
---

<Section id={SECTION_IDS[lang].services} surface="elevated" dividerTop={true}>
  <SectionHeader
    eyebrow={t.services.eyebrow}
    title={t.services.title}
    highlight={t.services.highlight}
    reveal={true}
  />

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {
      serviceList.map((service, index) => (
        <div class={`group relative reveal reveal-delay-${index + 1}`}>
          <div class="relative p-8 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:bg-white/[0.06] hover:border-brand-secondary/30 hover:shadow-xl hover:shadow-brand-secondary/5 transition-all duration-500 h-full">
            {/* Glow on hover */}
            <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-br from-brand-secondary/5 to-transparent pointer-events-none" />

            <div class="relative z-10">
              <div class="w-14 h-14 mb-6 flex items-center justify-center rounded-xl bg-brand-secondary/10 text-brand-secondary group-hover:bg-brand-secondary group-hover:text-white group-hover:shadow-lg group-hover:shadow-brand-secondary/25 group-hover:-translate-y-1 transition-all duration-300">
                <Icon name={service.iconName} size={28} strokeWidth={1.5} />
              </div>
              <h3 class="text-lg font-bold text-white mb-3 group-hover:text-brand-secondary transition-colors">
                {service.title[lang]}
              </h3>
              <p class="text-slate-400 text-sm leading-relaxed">
                {service.description[lang]}
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>
