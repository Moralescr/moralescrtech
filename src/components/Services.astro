---
import services from "../data/services.json";
---

<section
  id="services"
  class="py-16 lg:py-20 px-6 md:px-16 lg:px-24 xl:px-24 2xl:px-16 bg-brand-dark relative overflow-hidden"
>
  <!-- Top separator -->
  <div
    class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
  >
  </div>
  <!-- Subtle background accents (radial-gradient — GPU friendly) -->
  <div
    class="glow-orb absolute -top-40 -right-40 w-[600px] h-[600px] pointer-events-none"
    style="background: radial-gradient(circle, rgba(34,166,153,0.07) 0%, transparent 70%);"
  ></div>
  <div
    class="glow-orb absolute -bottom-40 -left-40 w-[500px] h-[500px] pointer-events-none"
    style="background: radial-gradient(circle, rgba(242,76,61,0.06) 0%, transparent 70%);"
  ></div>

  <div class="max-w-[1400px] 2xl:max-w-[1536px] mx-auto relative z-10">
    <div class="text-center mb-12 lg:mb-16 reveal">
      <span
        class="inline-block text-xs font-bold tracking-[0.2em] text-brand-secondary uppercase mb-4 px-4 py-2 rounded-full border border-brand-secondary/20 bg-brand-secondary/5"
      >
        Expertise
      </span>
      <h2
        class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mt-4"
      >
        What I <span class="text-brand-secondary">Build</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        services.map((service, index) => (
          <div class={`group relative reveal reveal-delay-${index + 1}`}>
            <div class="relative p-8 rounded-2xl bg-white/[0.03] border border-white/[0.06] hover:bg-white/[0.06] hover:border-brand-secondary/30 hover:shadow-xl hover:shadow-brand-secondary/5 transition-all duration-500 h-full">
              {/* Glow on hover */}
              <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-br from-brand-secondary/5 to-transparent pointer-events-none" />

              <div class="relative z-10">
                <div
                  class="w-14 h-14 mb-6 flex items-center justify-center rounded-xl bg-brand-secondary/10 text-brand-secondary group-hover:bg-brand-secondary group-hover:text-white group-hover:shadow-lg group-hover:shadow-brand-secondary/25 group-hover:-translate-y-1 transition-all duration-300"
                  set:html={service.icon}
                />
                <h3 class="text-lg font-bold text-white mb-3 group-hover:text-brand-secondary transition-colors">
                  {service.title}
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed">
                  {service.description}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
