---
import Container from "./ui/Container.astro";
import Icon from "./ui/Icon.astro";
import {
  SECTION_ANCHORS,
  SECTION_IDS,
  getAlternatePath,
  getLangFromUrl,
  getRoutePath,
  useTranslations,
  type Locale,
} from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = getLangFromUrl(Astro.url) }: Props = Astro.props;
const t = useTranslations(lang);
const currentPath =
  Astro.url.pathname === "/"
    ? "/"
    : Astro.url.pathname.replace(/\/+$/, "") || "/";

const otherLang: Locale = lang === "es" ? "en" : "es";
const switchHref = getAlternatePath(Astro.url.pathname, otherLang);

const navLinks = [
  { href: getRoutePath(lang, "home"), label: t.nav.home, key: "home" },
  {
    href: SECTION_ANCHORS[lang].services,
    label: t.nav.services,
    key: "services",
    sectionId: SECTION_IDS[lang].services,
  },
  {
    href: getRoutePath(lang, "projects"),
    label: t.nav.projects,
    key: "projects",
  },
  { href: getRoutePath(lang, "about"), label: t.nav.about, key: "about" },
];

function normalizeHref(href: string): string {
  return href === "/" ? "/" : href.replace(/\/+$/, "") || "/";
}

function isActive(link: { href: string; key: string }) {
  if (link.key === "services") return false;
  return currentPath === normalizeHref(link.href);
}
---

<header>
  <div class="fixed top-0 w-full z-50 text-sm">
    <nav
      id="main-nav"
      aria-label={t.nav.mainNavLabel}
      class="relative bg-transparent text-white transition-all duration-300"
    >
      <Container size="wide" class="h-[70px] flex items-center justify-between">
        <a
          href={getRoutePath(lang, "home")}
          class="shrink-0 flex items-center gap-2.5 group"
        >
          <div
            class="w-12 h-12 flex items-center justify-center border-2 border-brand-secondary rounded-full overflow-hidden"
          >
            <picture class="flex items-center justify-center w-full">
              <source srcset="/logo.webp" type="image/webp" />
              <img
                src="/logo.png"
                alt="Moralescr Tech logo"
                width="48"
                height="37"
                decoding="async"
                class="w-full h-auto object-contain"
              />
            </picture>
          </div>
          <span
            class="font-bold text-xl sm:text-2xl tracking-tight text-brand-primary group-hover:text-brand-secondary transition-colors"
          >
            Moralescr Tech
          </span>
        </a>

        <ul class="hidden md:flex items-center space-x-8">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-nav-key={link.key}
                  data-section-id={link.sectionId}
                  aria-current={isActive(link) ? "page" : undefined}
                  class:list={[
                    "nav-link transition-colors font-medium",
                    isActive(link)
                      ? "text-brand-secondary font-bold"
                      : "text-slate-200 hover:text-brand-secondary",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="hidden md:flex items-center gap-3">
          <a
            href={switchHref}
            aria-label={t.nav.switchLangLabel}
            hreflang={otherLang}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.04] border border-white/[0.1] text-xs font-semibold text-slate-300 hover:text-brand-secondary hover:border-brand-secondary/30 transition-colors"
          >
            <Icon name="globe" size={14} />
            <span>{t.nav.switchLangCode}</span>
          </a>
          <a
            href="https://github.com/moralescr"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white/[0.04] border border-white/[0.1] text-slate-300 hover:text-white hover:bg-white/[0.08] hover:border-brand-secondary/30 transition-colors"
          >
            <Icon name="github" size={18} />
          </a>
        </div>

        <button
          id="open-menu"
          aria-label={t.nav.openMenu}
          aria-controls="mobile-navLinks"
          aria-expanded="false"
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-lg text-white hover:bg-white/[0.08] md:hidden active:scale-95 transition"
        >
          <Icon name="menu" size={26} />
        </button>
      </Container>
    </nav>
  </div>
</header>

<!-- Mobile fullscreen menu -->
<div
  id="mobile-navLinks"
  role="dialog"
  aria-modal="true"
  aria-label={t.nav.mobileNavLabel}
  aria-hidden="true"
  inert
  class="fixed inset-0 z-[100] bg-brand-dark/95 text-white backdrop-blur-xl flex flex-col justify-between p-6 md:hidden transition-transform duration-300 -translate-x-full"
>
  <div class="flex items-center justify-between h-[54px]">
    <a
      href={getRoutePath(lang, "home")}
      class="flex items-center gap-2.5 group"
    >
      <div
        class="w-12 h-12 flex items-center justify-center border-2 border-brand-secondary rounded-full overflow-hidden"
      >
        <picture class="flex items-center justify-center w-full">
          <source srcset="/logo.webp" type="image/webp" />
          <img
            src="/logo.png"
            alt="Moralescr Tech logo"
            width="48"
            height="37"
            decoding="async"
            class="w-full h-auto object-contain"
          />
        </picture>
      </div>
      <span
        class="font-bold text-xl tracking-tight text-brand-primary group-hover:text-brand-secondary transition-colors"
      >
        Moralescr Tech
      </span>
    </a>

    <button
      id="close-menu"
      type="button"
      aria-label={t.nav.closeMenu}
      class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white/[0.06] border border-white/[0.1] text-white hover:text-brand-secondary hover:border-brand-secondary/30 transition"
    >
      <Icon name="close" size={22} />
    </button>
  </div>

  <nav aria-label={t.nav.mobileNavLabel} class="flex flex-col items-center gap-7 my-auto">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          data-nav-key={link.key}
          data-section-id={link.sectionId}
          aria-current={isActive(link) ? "page" : undefined}
          class:list={[
            "mobile-nav-link text-2xl font-semibold transition-colors",
            isActive(link)
              ? "text-brand-secondary"
              : "text-slate-200 hover:text-brand-secondary",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="flex flex-col gap-3 pt-6 border-t border-white/[0.08]">
    <a
      href={switchHref}
      aria-label={t.nav.switchLangLabel}
      hreflang={otherLang}
      class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-white/[0.1] bg-white/[0.04] text-slate-200 text-sm font-semibold hover:text-brand-secondary hover:border-brand-secondary/30 transition-colors"
    >
      <Icon name="globe" size={16} />
      <span>{t.nav.switchLangLabel} ({t.nav.switchLangCode})</span>
    </a>
    <a
      href="https://github.com/moralescr"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-white/[0.1] bg-white/[0.04] text-slate-200 text-sm font-semibold hover:text-white hover:bg-white/[0.08] hover:border-brand-secondary/30 transition-colors"
    >
      <Icon name="github" size={18} />
      <span>GitHub</span>
    </a>
  </div>
</div>

<script>
  let navAbortController: AbortController | null = null;
  let sectionObserver: IntersectionObserver | null = null;

  function initNavigation() {
    navAbortController?.abort();
    sectionObserver?.disconnect();
    navAbortController = new AbortController();
    const { signal } = navAbortController;

    document.body.style.overflow = "";

    const openMenu = document.getElementById("open-menu");
    const closeMenu = document.getElementById("close-menu");
    const mobileNav = document.getElementById("mobile-navLinks");
    const nav = document.getElementById("main-nav");

    const isMobile = () => window.innerWidth <= 768;

    function updateNav() {
      if (!nav) return;
      if (window.scrollY > 80) {
        const classes = [
          "bg-brand-dark/80",
          "shadow-sm",
          "border-b",
          "border-white/[0.06]",
        ];
        if (!isMobile()) classes.push("backdrop-blur-xl");
        nav.classList.add(...classes);
        nav.classList.remove("bg-transparent");
      } else {
        nav.classList.remove(
          "bg-brand-dark/80",
          "backdrop-blur-xl",
          "shadow-sm",
          "border-b",
          "border-white/[0.06]",
        );
        nav.classList.add("bg-transparent");
      }
    }

    window.addEventListener("scroll", updateNav, { passive: true, signal });
    updateNav();

    function isMenuOpen() {
      return mobileNav !== null && !mobileNav.classList.contains("-translate-x-full");
    }

    function openMobileMenu() {
      if (!mobileNav) return;
      mobileNav.classList.remove("-translate-x-full");
      mobileNav.removeAttribute("inert");
      mobileNav.setAttribute("aria-hidden", "false");
      openMenu?.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      closeMenu?.focus();
    }

    function closeMobileMenu(restoreFocus = true) {
      if (!mobileNav) return;
      mobileNav.classList.add("-translate-x-full");
      mobileNav.setAttribute("inert", "");
      mobileNav.setAttribute("aria-hidden", "true");
      openMenu?.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      if (restoreFocus) {
        openMenu?.focus();
      }
    }

    openMenu?.addEventListener("click", openMobileMenu, { signal });
    closeMenu?.addEventListener("click", () => closeMobileMenu(true), { signal });

    mobileNav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => closeMobileMenu(false), { signal });
    });

    document.addEventListener(
      "keydown",
      (event) => {
        if (!isMenuOpen() || !mobileNav) return;

        if (event.key === "Escape") {
          event.preventDefault();
          closeMobileMenu(true);
          return;
        }

        if (event.key === "Tab") {
          const focusables = Array.from(
            mobileNav.querySelectorAll<HTMLElement>(
              'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
            ),
          );
          if (focusables.length === 0) return;

          const first = focusables[0];
          const last = focusables[focusables.length - 1];

          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      },
      { signal },
    );

    // Home page scroll-spy between Home and Services
    const serviceLink = document.querySelector<HTMLAnchorElement>(
      "a[data-section-id]",
    );
    const serviceSectionId = serviceLink?.dataset.sectionId;
    const serviceSection = serviceSectionId
      ? document.getElementById(serviceSectionId)
      : null;

    if (serviceSection) {
      const homeLinks = document.querySelectorAll<HTMLAnchorElement>(
        'a[data-nav-key="home"]',
      );
      const serviceLinks = document.querySelectorAll<HTMLAnchorElement>(
        'a[data-nav-key="services"]',
      );

      const setActiveGroup = (activeKey: "home" | "services") => {
        homeLinks.forEach((el) => {
          const isDesktop = el.classList.contains("nav-link");
          if (activeKey === "home") {
            el.setAttribute("aria-current", "page");
            el.classList.add("text-brand-secondary");
            if (isDesktop) el.classList.add("font-bold");
            el.classList.remove("text-slate-200");
          } else {
            el.removeAttribute("aria-current");
            el.classList.remove("text-brand-secondary", "font-bold");
            el.classList.add("text-slate-200");
          }
        });

        serviceLinks.forEach((el) => {
          const isDesktop = el.classList.contains("nav-link");
          if (activeKey === "services") {
            el.setAttribute("aria-current", "true");
            el.classList.add("text-brand-secondary");
            if (isDesktop) el.classList.add("font-bold");
            el.classList.remove("text-slate-200");
          } else {
            el.removeAttribute("aria-current");
            el.classList.remove("text-brand-secondary", "font-bold");
            el.classList.add("text-slate-200");
          }
        });
      };

      sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActiveGroup("services");
            } else if (entry.boundingClientRect.top > 0) {
              setActiveGroup("home");
            }
          });
        },
        { rootMargin: "-25% 0px -55% 0px" },
      );

      sectionObserver.observe(serviceSection);
    }
  }

  document.addEventListener("astro:page-load", initNavigation);
</script>
