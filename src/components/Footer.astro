---
import Container from "./ui/Container.astro";
import GlowOrb from "./ui/GlowOrb.astro";
import Icon, { type IconName } from "./ui/Icon.astro";
import {
  SECTION_ANCHORS,
  getAlternatePath,
  getLangFromUrl,
  getRoutePath,
  useTranslations,
  type Locale,
} from "../i18n";

interface Props {
  lang?: Locale;
}

interface SocialLink {
  name: string;
  href: string;
  icon: IconName;
  hoverClass: string;
}

const { lang = getLangFromUrl(Astro.url) }: Props = Astro.props;
const t = useTranslations(lang);
const otherLang: Locale = lang === "es" ? "en" : "es";
const switchHref = getAlternatePath(Astro.url.pathname, otherLang);
const email = "moralescrtech@gmail.com";

const footerLinks = [
  { href: getRoutePath(lang, "home"), label: t.nav.home },
  { href: SECTION_ANCHORS[lang].services, label: t.nav.services },
  { href: getRoutePath(lang, "projects"), label: t.nav.projects },
  { href: getRoutePath(lang, "about"), label: t.nav.about },
];

const socialLinks: SocialLink[] = [
  {
    name: "GitHub",
    href: "https://github.com/moralescr",
    icon: "github",
    hoverClass:
      "hover:text-white hover:bg-white/[0.08] hover:border-brand-secondary/30",
  },
  {
    name: "LinkedIn",
    href: "https://www.linkedin.com/in/moralescr/",
    icon: "linkedin",
    hoverClass:
      "hover:text-blue-400 hover:bg-blue-400/10 hover:border-blue-400/30",
  },
  {
    name: "YouTube",
    href: "https://www.youtube.com/@MoralescrTech",
    icon: "youtube",
    hoverClass:
      "hover:text-red-400 hover:bg-red-400/10 hover:border-red-400/30",
  },
  {
    name: "TikTok",
    href: "https://www.tiktok.com/@moralescr_tech",
    icon: "tiktok",
    hoverClass:
      "hover:text-white hover:bg-white/[0.08] hover:border-white/20",
  },
  {
    name: "Instagram",
    href: "https://www.instagram.com/moralescr_tech/",
    icon: "instagram",
    hoverClass:
      "hover:text-pink-400 hover:bg-pink-400/10 hover:border-pink-400/30",
  },
];
---

<footer
  class="bg-brand-dark border-t border-white/[0.06] relative overflow-hidden"
>
  <!-- Background glow -->
  <GlowOrb
    color="teal"
    position="bottom-center"
    size="lg"
    intensity="subtle"
    class="h-[300px]"
  />

  <Container class="relative z-10">
    <!-- Main footer grid -->
    <div class="py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Column 1: Brand -->
      <div class="flex flex-col items-start gap-3">
        <a
          href={getRoutePath(lang, "home")}
          class="flex items-center gap-2.5 group"
        >
          <div
            class="w-12 h-12 flex items-center justify-center border-2 border-brand-secondary rounded-full overflow-hidden"
          >
            <picture class="flex items-center justify-center w-full">
              <source srcset="/logo.webp" type="image/webp" />
              <img
                src="/logo.png"
                alt="Moralescr Tech logo"
                width="48"
                height="37"
                loading="lazy"
                decoding="async"
                class="w-full h-auto object-contain"
              />
            </picture>
          </div>
          <span
            class="font-bold text-xl tracking-tight text-brand-primary group-hover:text-brand-secondary transition-colors"
          >
            Moralescr Tech
          </span>
        </a>
        <p class="text-sm text-slate-400 max-w-xs leading-relaxed">
          {t.footer.tagline}
        </p>
      </div>

      <!-- Column 2: Navigation -->
      <div>
        <h2
          class="text-xs font-bold uppercase tracking-[0.15em] text-slate-300 mb-4"
        >
          {t.footer.navHeading}
        </h2>
        <ul class="space-y-2.5 text-sm">
          {
            footerLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-400 hover:text-brand-secondary transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Column 3: Contact -->
      <div>
        <h2
          class="text-xs font-bold uppercase tracking-[0.15em] text-slate-300 mb-4"
        >
          {t.footer.contactHeading}
        </h2>
        <div class="flex flex-col items-start gap-3">
          <a
            href={`mailto:${email}`}
            class="inline-flex items-center gap-2 text-sm text-slate-300 hover:text-brand-secondary transition-colors break-all"
          >
            <Icon name="mail" size={15} class="shrink-0 text-brand-secondary" />
            <span>{email}</span>
          </a>
          <button
            type="button"
            data-copy-email={email}
            data-copy-label={t.footer.copyEmail}
            data-copied-label={t.footer.copiedEmail}
            aria-live="polite"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.04] border border-white/[0.08] text-xs font-medium text-slate-300 hover:text-brand-secondary hover:border-brand-secondary/30 transition-colors active:scale-95"
          >
            <Icon name="copy" size={14} class="copy-icon" />
            <Icon name="check" size={14} class="check-icon hidden text-brand-secondary" />
            <span class="copy-text">{t.footer.copyEmail}</span>
          </button>
        </div>
      </div>

      <!-- Column 4: Social & Language -->
      <div>
        <h2
          class="text-xs font-bold uppercase tracking-[0.15em] text-slate-300 mb-4"
        >
          {t.footer.socialHeading}
        </h2>
        <div class="flex flex-wrap items-center gap-3 mb-5">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "w-10 h-10 flex items-center justify-center rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-400 hover:scale-110 transition-all duration-300",
                  social.hoverClass,
                ]}
                aria-label={social.name}
              >
                <Icon name={social.icon} size={18} />
              </a>
            ))
          }
        </div>
        <a
          href={switchHref}
          hreflang={otherLang}
          aria-label={t.nav.switchLangLabel}
          class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400 hover:text-brand-secondary transition-colors"
        >
          <Icon name="globe" size={14} />
          <span>{t.footer.switchLangText}</span>
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="py-6 border-t border-white/[0.06] flex flex-col sm:flex-row justify-between items-center gap-4"
    >
      <p class="text-xs text-slate-400">
        &copy; {new Date().getFullYear()}
        {t.footer.rights}
      </p>
      <p class="text-xs text-slate-400">
        {t.footer.madeWithPrefix}
        <span class="text-brand-primary">❤</span>
        {t.footer.madeWithSuffix}
      </p>
    </div>
  </Container>
</footer>

<script>
  let copyTimer: ReturnType<typeof setTimeout> | null = null;

  function initFooterCopyButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      "button[data-copy-email]",
    );

    buttons.forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", async () => {
        const email = btn.dataset.copyEmail;
        const copyLabel = btn.dataset.copyLabel || "Copy email";
        const copiedLabel = btn.dataset.copiedLabel || "Copied!";
        if (!email) return;

        try {
          if (!navigator.clipboard?.writeText) return;
          await navigator.clipboard.writeText(email);
        } catch {
          return;
        }

        const copyIcon = btn.querySelector(".copy-icon");
        const checkIcon = btn.querySelector(".check-icon");
        const textEl = btn.querySelector(".copy-text");

        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        if (textEl) textEl.textContent = copiedLabel;

        if (copyTimer) clearTimeout(copyTimer);
        copyTimer = setTimeout(() => {
          copyIcon?.classList.remove("hidden");
          checkIcon?.classList.add("hidden");
          if (textEl) textEl.textContent = copyLabel;
        }, 2000);
      });
    });
  }

  document.addEventListener("astro:page-load", initFooterCopyButtons);
</script>
