---
import Icon from "./Icon.astro";

interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  align?: "center" | "left";
  as?: "h1" | "h2";
  backHref?: string;
  backLabel?: string;
  reveal?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  highlight,
  description,
  align = "center",
  as: HeadingTag = "h2",
  backHref,
  backLabel = "Back to home",
  reveal = false,
  class: className = "",
}: Props = Astro.props;

const currentLabel = highlight ? `${title} ${highlight}` : title;
---

<div
  class:list={[
    "mb-12 lg:mb-16",
    align === "center" ? "text-center" : "text-left",
    reveal && "reveal",
    className,
  ]}
>
  {
    backHref && (
      <nav aria-label="Breadcrumb" class="mb-6">
        <ol
          class:list={[
            "inline-flex flex-wrap items-center gap-2 text-sm text-slate-400",
            align === "center" && "justify-center",
          ]}
        >
          <li>
            <a
              href={backHref}
              class="inline-flex items-center gap-1.5 hover:text-brand-secondary transition-colors"
            >
              <Icon name="arrow-left" size={14} />
              <span>{backLabel}</span>
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-400">
            /
          </li>
          <li aria-current="page" class="text-slate-200 font-medium">
            {currentLabel}
          </li>
        </ol>
      </nav>
    )
  }

  {
    eyebrow && (
      <div class="mb-4">
        <span class="inline-block text-xs font-bold tracking-[0.2em] text-brand-secondary uppercase px-4 py-2 rounded-full border border-brand-secondary/20 bg-brand-secondary/5">
          {eyebrow}
        </span>
      </div>
    )
  }

  <HeadingTag
    class="text-4xl md:text-5xl font-extrabold text-white tracking-tight"
  >
    {title}
    {
      highlight && (
        <>
          {" "}
          <span class="text-brand-secondary">{highlight}</span>
        </>
      )
    }
  </HeadingTag>

  {
    description && (
      <p
        class:list={[
          "text-slate-400 text-lg max-w-2xl mt-4 leading-relaxed",
          align === "center" && "mx-auto",
        ]}
      >
        {description}
      </p>
    )
  }
</div>
