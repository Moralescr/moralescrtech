---
import Container from "./ui/Container.astro";
import GlowOrb from "./ui/GlowOrb.astro";
import Button from "./ui/Button.astro";
import Badge from "./ui/Badge.astro";
import Icon from "./ui/Icon.astro";
import {
  getLangFromUrl,
  getRoutePath,
  useTranslations,
  type Locale,
} from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = getLangFromUrl(Astro.url) }: Props = Astro.props;
const t = useTranslations(lang);

const stack = ["RPG", "Laravel", "Astro", "Vue.js", "DB2", "MySQL", "GIT"];
---

<section class="relative overflow-hidden min-h-svh lg:min-h-0 bg-brand-dark">
  <!-- Animated background grid -->
  <div class="absolute inset-0 opacity-[0.03]" aria-hidden="true">
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"
    >
    </div>
  </div>

  <!-- Glow orbs (radial-gradient — GPU friendly) -->
  <GlowOrb color="teal" position="top-left" size="lg" intensity="strong" />
  <GlowOrb color="coral" position="bottom-right" size="md" intensity="strong" />
  <GlowOrb color="teal" position="center" size="xl" intensity="subtle" />

  <div class="relative z-10 w-full pt-[120px] lg:pt-[140px] pb-16 lg:pb-20">
    <Container
      size="wide"
      class="flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-16 xl:gap-20"
    >
      <!-- Left: Text Content -->
      <div
        class="flex flex-col items-center lg:items-start w-full lg:max-w-2xl xl:max-w-3xl min-w-0"
      >
        <!-- Status badge -->
        <Badge
          variant="accent"
          size="md"
          class="mb-8 text-sm font-semibold tracking-wide uppercase"
        >
          {t.hero.badge}
        </Badge>

        <h1
          class="text-center lg:text-left text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight text-white leading-[1.1] mb-6 min-h-[100px] md:min-h-[120px] lg:min-h-[140px]"
        >
          {t.hero.greeting}
          <span class="text-brand-secondary"> {t.hero.name}</span>
          <span class="sr-only"> — {t.hero.phrases[0]}</span>
          <br aria-hidden="true" />
          <span
            aria-hidden="true"
            class="text-slate-400 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold inline-flex items-center"
            ><type-writer data-phrases={JSON.stringify(t.hero.phrases)}
              >{t.hero.phrases[0]}</type-writer
            ><span
              class="w-[3px] md:w-[4px] h-[30px] md:h-[40px] lg:h-[48px] bg-brand-secondary ml-2 animate-pulse"
            ></span>
          </span>
        </h1>

        <p
          class="text-center lg:text-left text-base md:text-lg text-slate-400 max-w-lg mb-10 leading-relaxed"
        >
          {t.hero.descriptionPrefix}
          <span class="text-brand-secondary font-medium">
            {t.hero.descriptionHighlight1}</span
          >{" "}
          {t.hero.descriptionMiddle}
          <span class="text-brand-secondary font-medium">
            {t.hero.descriptionHighlight2}</span
          >
        </p>

        <div
          class="flex flex-wrap items-center justify-center lg:justify-start gap-4"
        >
          <Button
            href="mailto:moralescrtech@gmail.com"
            variant="primary"
            size="lg"
          >
            <Icon name="mail" size={18} />
            {t.hero.primaryCta}
          </Button>
          <Button
            href={getRoutePath(lang, "projects")}
            variant="secondary"
            size="lg"
          >
            {t.hero.secondaryCta}
            <Icon name="arrow-right" size={18} />
          </Button>
        </div>

        <!-- Tech stack pills -->
        <div
          class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mt-12"
        >
          {
            stack.map((tech) => (
              <Badge
                variant="neutral"
                size="sm"
                class="hover:border-brand-secondary/40 hover:text-brand-secondary transition-colors cursor-default"
              >
                {tech}
              </Badge>
            ))
          }
        </div>
      </div>

      <!-- Right: Terminal/Code window -->
      <div
        class="w-full max-w-sm lg:max-w-md xl:max-w-lg 2xl:max-w-2xl flex-shrink-0 animate-float-slow"
      >
        <div
          class="rounded-2xl border border-white/10 bg-white/5 md:backdrop-blur-xl shadow-2xl overflow-hidden"
        >
          <!-- Terminal header -->
          <div
            class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/10"
          >
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-400/80"></div>
            </div>
            <span class="text-xs text-slate-400 ml-2 font-mono"
              >~/moralescr-tech</span
            >
          </div>
          <!-- Terminal body -->
          <div class="p-6 font-mono text-sm leading-7">
            <p>
              <span class="text-brand-secondary">const</span>
              <span class="text-blue-400">developer</span>
              <span class="text-brand-primary">=</span>
              <span class="text-yellow-300">{"{"}</span>
            </p>
            <p class="pl-4">
              <span class="text-slate-400">name:</span>
              <span class="text-green-400">"Adrián Morales"</span>,
            </p>
            <p class="pl-4">
              <span class="text-slate-400">current_role:</span>
              <span class="text-green-400">"{t.hero.roleValue}"</span>,
            </p>
            <p class="pl-4">
              <span class="text-slate-400">location:</span>
              <span class="text-green-400">"{t.hero.locationValue}"</span>,
            </p>
            <p class="pl-4">
              <span class="text-slate-400">passion:</span>
              <span class="text-green-400">"{t.hero.passionValue}"</span>,
            </p>
            <p><span class="text-yellow-300">{"}"}</span>;</p>
            <p class="mt-3">
              <span class="text-brand-secondary">&gt;</span>
              <span class="text-slate-300 ml-2">{t.hero.prompt}</span>
              <span class="text-brand-secondary cursor-blink ml-0.5">▊</span>
            </p>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <!-- Scroll indicator -->
  <div
    aria-hidden="true"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-400 animate-bounce"
  >
    <Icon name="chevron-down" size={16} />
  </div>

  <script>
    import "../scripts/TypeWriter.ts";
  </script>
</section>
