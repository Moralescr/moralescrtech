---
import Navbar from "./Navbar.astro";

const stack = [
  "RPG",
  "Laravel",
  "Astro",
  "Vue.js",
  "DB2",
  "MySQL",
  "GIT"
];
---

<section class="relative overflow-hidden min-h-svh lg:min-h-0 bg-brand-dark">
  <Navbar />

  <!-- Animated background grid -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"
    >
    </div>
  </div>

  <!-- Glow orbs (radial-gradient — GPU friendly) -->
  <div
    class="glow-orb absolute top-20 -left-32 w-[600px] h-[600px] pointer-events-none"
    style="background: radial-gradient(circle, rgba(34,166,153,0.18) 0%, transparent 70%);"
  ></div>
  <div
    class="glow-orb absolute bottom-10 -right-32 w-[500px] h-[500px] pointer-events-none"
    style="background: radial-gradient(circle, rgba(242,76,61,0.12) 0%, transparent 70%);"
  ></div>
  <div
    class="glow-orb absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] pointer-events-none"
    style="background: radial-gradient(circle, rgba(34,166,153,0.06) 0%, transparent 65%);"
  ></div>

  <main class="relative z-10 w-full pt-[120px] lg:pt-[140px] pb-16 lg:pb-20 px-6 md:px-16 lg:px-24 xl:px-24 2xl:px-16">
    <div class="max-w-[1600px] mx-auto flex flex-col lg:flex-row items-center justify-center gap-8 lg:gap-16 xl:gap-20">
      <!-- Left: Text Content -->
      <div class="flex flex-col items-center lg:items-start w-full lg:max-w-2xl xl:max-w-3xl min-w-0">
      <!-- Status badge -->
      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-secondary/10 border border-brand-secondary/20 mb-8"
      >
        <span
          class="text-brand-secondary text-sm font-semibold tracking-wide uppercase"
          >Costa Rica - Pura vida!</span
        >
      </div>

      <h1
        class="text-center lg:text-left text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight text-white leading-[1.1] mb-6 min-h-[100px] md:min-h-[120px] lg:min-h-[140px]"
      >
        Hi, I'm
        <span class="text-brand-secondary"> Adrián</span>
        <br />
        <span
          class="text-slate-400 text-4xl md:text-5xl lg:text-6xl font-bold inline-flex items-center"
          ><type-writer
            data-phrases='["Full Stack developer", "IBM i Developer", "Entrepreneur", "Tech Enthusiast"]'
            >Full Stack developer</type-writer
          ><span
            class="w-[3px] md:w-[4px] h-[30px] md:h-[40px] lg:h-[48px] bg-brand-secondary ml-2 animate-pulse"
          ></span>
          </span>
      </h1>

      <p
        class="text-center lg:text-left text-base md:text-lg text-slate-400 max-w-lg mb-10 leading-relaxed"
      >
        Building scalable web apps, landing pages & websites from
        <span class="text-brand-secondary font-medium"> MVP</span> to
        <span class="text-brand-secondary font-medium"> growth.</span>
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="mailto:moralescrtech@gmail.com"
          class="group relative inline-flex items-center gap-2 px-8 py-4 bg-brand-secondary hover:bg-brand-secondary/90 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-brand-secondary/25 hover:shadow-brand-secondary/40 hover:-translate-y-0.5 active:scale-95"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect><path
              d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          Contact me
        </a>
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-xl border border-white/10 hover:border-white/20 transition-all duration-300 hover:-translate-y-0.5 active:scale-95"
        >
          View Projects
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Tech stack pills -->
      <div class="flex flex-wrap items-center gap-3 mt-12">
        {
          stack.map((tech) => (
            <span class="px-3 py-1.5 text-xs font-medium text-slate-400 bg-white/5 border border-white/10 rounded-lg hover:border-brand-secondary/40 hover:text-brand-secondary transition-colors cursor-default">
              {tech}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Right: Terminal/Code window -->
    <div class="w-full max-w-sm lg:max-w-md xl:max-w-lg 2xl:max-w-2xl flex-shrink-0 animate-float-slow">
      <div
        class="rounded-2xl border border-white/10 bg-white/5 md:backdrop-blur-xl shadow-2xl overflow-hidden"
      >
        <!-- Terminal header -->
        <div
          class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/10"
        >
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-400/80"></div>
          </div>
          <span class="text-xs text-slate-500 ml-2 font-mono"
            >~/moralescr-tech</span
          >
        </div>
        <!-- Terminal body -->
        <div class="p-6 font-mono text-sm leading-7">
          <p>
            <span class="text-brand-secondary">const</span>
            <span class="text-blue-400">developer</span>
            <span class="text-brand-primary">=</span>
            <span class="text-yellow-300">{"{"}</span>
          </p>
          <p class="pl-4">
            <span class="text-slate-400">name:</span>
            <span class="text-green-400">"Adrián Morales"</span>,
          </p>
          <p class="pl-4">
            <span class="text-slate-400">current_role:</span>
            <span class="text-green-400">"ATM Engineer"</span>,
          </p>
          <p class="pl-4">
            <span class="text-slate-400">location:</span>
            <span class="text-green-400">"Costa Rica"</span>,
          </p>
          <p class="pl-4">
            <span class="text-slate-400">passion:</span>
            <span class="text-green-400">"Building the future"</span>,
          </p>
          <p><span class="text-yellow-300">{"}"}</span>;</p>
          <p class="mt-3">
            <span class="text-brand-secondary">&gt;</span>
            <span class="text-slate-300 ml-2">Let's build something amazing together!</span>
            <span class="text-brand-secondary cursor-blink ml-0.5">▊</span>
          </p>
        </div>
      </div>
    </div>

    </div>
  </main>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-500 animate-bounce"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>

  <script>
    import "../scripts/TypeWriter.ts";
  </script>
</section>
