---
import Navbar from "./Navbar.astro";

const stack = [
  "Vue.js",
  "Astro",
  "Node.js",
  "Laravel",
  "Supabase",
  "RPG",
  "DB2",
];
---

<section class="relative overflow-hidden min-h-screen bg-brand-dark">
  <Navbar />

  <!-- Animated background grid -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div
      class="absolute inset-0"
      style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"
    >
    </div>
  </div>

  <!-- Glow orbs -->
  <div
    class="absolute top-20 -left-32 w-[500px] h-[500px] bg-brand-secondary/20 rounded-full blur-[120px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-10 -right-32 w-[400px] h-[400px] bg-brand-primary/15 rounded-full blur-[100px] pointer-events-none"
  >
  </div>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-secondary/5 rounded-full blur-[150px] pointer-events-none"
  >
  </div>

  <main
    class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-20 pt-[140px] pb-24 px-6 md:px-16 lg:px-24 xl:px-32"
  >
    <!-- Left: Text Content -->
    <div class="flex flex-col items-center lg:items-start max-w-2xl">
      <!-- Status badge -->
      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-secondary/10 border border-brand-secondary/20 mb-8"
      >
        <span class="relative flex h-2.5 w-2.5">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-secondary opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-secondary"
          ></span>
        </span>
        <span
          class="text-brand-secondary text-xs font-semibold tracking-wide uppercase"
          >Available for projects</span
        >
      </div>

      <h1
        class="text-center lg:text-left text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.1] mb-6 h-[120px] md:h-[140px] lg:h-[160px]"
      >
        Hi, I'm
        <span class="text-brand-secondary"> Adrián</span>
        <br />
        <span
          class="text-slate-400 text-4xl md:text-5xl lg:text-6xl font-bold inline-flex items-center"
          ><type-writer
            data-phrases='["Web Developer", "Software Engineer", "IBM i Expert", "Problem Solver"]'
            >Web Developer</type-writer
          ><span
            class="w-[3px] md:w-[4px] h-[36px] md:h-[48px] lg:h-[60px] bg-brand-secondary ml-2 animate-pulse"
          ></span></span
        >
      </h1>

      <p
        class="text-center lg:text-left text-base md:text-lg text-slate-400 max-w-lg mb-10 leading-relaxed"
      >
        Building scalable web apps, landing pages & websites from
        <span class="text-brand-secondary font-medium"> MVP</span> to
        <span class="text-brand-secondary font-medium"> growth.</span>
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="mailto:moralescrtech@gmail.com"
          class="group relative inline-flex items-center gap-2 px-8 py-4 bg-brand-secondary hover:bg-brand-secondary/90 text-white font-semibold rounded-xl transition-all duration-300 shadow-lg shadow-brand-secondary/25 hover:shadow-brand-secondary/40 hover:-translate-y-0.5 active:scale-95"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect><path
              d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          Contact me
        </a>
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-8 py-4 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-xl border border-white/10 hover:border-white/20 transition-all duration-300 hover:-translate-y-0.5 active:scale-95"
        >
          View Projects
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Tech stack pills -->
      <div class="flex flex-wrap items-center gap-3 mt-12">
        {
          stack.map((tech) => (
            <span class="px-3 py-1.5 text-xs font-medium text-slate-400 bg-white/5 border border-white/10 rounded-lg hover:border-brand-secondary/40 hover:text-brand-secondary transition-colors cursor-default">
              {tech}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Right: Terminal/Code window -->
    <div class="w-full max-w-md lg:max-w-lg animate-float-slow">
      <div
        class="rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl shadow-2xl overflow-hidden"
      >
        <!-- Terminal header -->
        <div
          class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/10"
        >
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-400/80"></div>
          </div>
          <span class="text-xs text-slate-500 ml-2 font-mono"
            >~/moralescr-tech</span
          >
        </div>
        <!-- Terminal body -->
        <div class="p-6 font-mono text-sm leading-7">
          <p>
            <span class="text-brand-secondary">const</span>
            <span class="text-blue-400">developer</span>
            <span class="text-brand-primary">=</span>
            <span class="text-yellow-300">{"{"}</span>
          </p>
          <p class="pl-4">
            <span class="text-slate-400">name:</span>
            <span class="text-green-400">"Adrián Morales"</span>,
          </p>
          <p class="pl-4">
            <span class="text-slate-400">role:</span>
            <span class="text-green-400">"Web Developer"</span>,
          </p>
          <p class="pl-4">
            <span class="text-slate-400">location:</span>
            <span class="text-green-400">"Costa Rica 🇨🇷"</span>,
          </p>
          <p class="pl-4">
            <span class="text-slate-400">passion:</span>
            <span class="text-green-400">"Building the future"</span>,
          </p>
          <p><span class="text-yellow-300">{"}"}</span>;</p>
          <p class="mt-3">
            <span class="text-brand-secondary">></span>
            <span class="text-slate-300 ml-2">Ready to collaborate</span>
            <span class="text-brand-secondary cursor-blink ml-0.5">▊</span>
          </p>
        </div>
      </div>
    </div>
  </main>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-500 animate-bounce"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>

  <script>
    class TypeWriter extends HTMLElement {
      texts: string[] = [];
      textIndex: number = 0;
      charIndex: number = 0;
      isDeleting: boolean = false;

      connectedCallback() {
        this.texts = JSON.parse(this.dataset.phrases || "[]");
        if (this.texts.length === 0) return;

        this.textIndex = 0;
        this.charIndex = this.texts[0].length;
        this.isDeleting = false;

        // Start deleting after the initial delay
        setTimeout(() => {
          this.isDeleting = true;
          this.type();
        }, 2500);
      }

      type() {
        const currentText = this.texts[this.textIndex];

        if (this.isDeleting) {
          this.textContent = currentText.substring(0, this.charIndex - 1);
          this.charIndex--;
        } else {
          this.textContent = currentText.substring(0, this.charIndex + 1);
          this.charIndex++;
        }

        let typeSpeed = this.isDeleting ? 40 : 80;

        if (!this.isDeleting && this.charIndex === currentText.length) {
          typeSpeed = 2500; // Pause to complete the word
          this.isDeleting = true;
        } else if (this.isDeleting && this.charIndex === 0) {
          this.isDeleting = false;
          this.textIndex = (this.textIndex + 1) % this.texts.length;
          typeSpeed = 500; // Pause before new word
        }

        setTimeout(() => this.type(), typeSpeed);
      }
    }

    // Component register
    customElements.define("type-writer", TypeWriter);
  </script>
</section>
