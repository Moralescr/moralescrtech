---
import EventItem from "./EventItem.astro";
import events from "../data/events.json";
---

<section
  id="events"
  class="py-16 lg:py-20 px-6 md:px-16 lg:px-24 xl:px-24 2xl:px-16 bg-brand-dark relative overflow-hidden"
>
  <!-- Background glow (radial-gradient — GPU friendly) -->
  <div
    class="glow-orb absolute -top-40 right-0 w-[500px] h-[500px] pointer-events-none"
    style="background: radial-gradient(circle, rgba(34,166,153,0.07) 0%, transparent 70%);"
  ></div>
  <div
    class="glow-orb absolute bottom-0 -left-20 w-[400px] h-[400px] pointer-events-none"
    style="background: radial-gradient(circle, rgba(242,76,61,0.06) 0%, transparent 70%);"
  ></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <div class="mb-16 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-brand-secondary transition-colors mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path>
        </svg>
        Back to home
      </a>
      <h2
        class="text-4xl md:text-5xl font-extrabold text-white mb-6 tracking-tight"
      >
        My <span class="text-brand-secondary">Events</span>
      </h2>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">
        Conferences, hackathons, and community events where I've participated to
        learn, share, and connect.
      </p>
    </div>

    <div class="relative border-l border-white/[0.08] ml-3 md:ml-6 mt-10">
      {
        events.map((event) => (
          <EventItem
            title={event.title}
            date={event.date}
            location={event.location}
            role={event.role}
            description={event.description}
            image={event.image}
            link={event.link}
          />
        ))
      }
    </div>
  </div>
</section>
