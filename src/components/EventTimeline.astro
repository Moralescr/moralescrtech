---
import EventItem from "./EventItem.astro";
import events from "../data/events.json";
---

<section
  id="events"
  class="py-24 px-6 md:px-16 lg:px-24 xl:px-32 bg-brand-dark relative overflow-hidden"
>
  <!-- Background glow -->
  <div class="absolute -top-40 right-0 w-[400px] h-[400px] bg-brand-secondary/[0.06] rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 -left-20 w-[300px] h-[300px] bg-brand-primary/[0.05] rounded-full blur-[100px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto relative z-10">
    <div class="mb-16 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-brand-secondary transition-colors mb-6"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
        </svg>
        Back to home
      </a>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-6 tracking-tight">
        My <span class="text-brand-secondary">Events</span>
      </h2>
      <p class="text-slate-400 text-lg max-w-2xl mx-auto">
        Conferences, hackathons, and community events where I've participated to
        learn, share, and connect.
      </p>
    </div>

    <div class="relative border-l border-white/[0.08] ml-3 md:ml-6 mt-10">
      {events.map((event) => (
        <EventItem
          title={event.title}
          date={event.date}
          location={event.location}
          role={event.role}
          description={event.description}
          image={event.image}
          link={event.link}
        />
      ))}
    </div>
  </div>
</section>
