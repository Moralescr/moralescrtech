---
import ProjectCard from "./ProjectCard.astro";
import projects from "../data/projects.json";

// Show only the first 3 on the home page
const featured = projects.slice(0, 3);
---

<section
  id="projects"
  class="py-24 px-6 md:px-16 lg:px-24 xl:px-32 bg-slate-50 relative overflow-hidden"
>
  <!-- Background blobs -->
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-teal-200/40 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute bottom-20 -left-20 w-72 h-72 bg-red-200/40 rounded-full blur-[80px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="mb-16 text-center reveal">
      <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 tracking-tight">
        Featured <span class="text-brand-secondary">Projects</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 reveal reveal-delay-2">
      {featured.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          image={project.image}
          link={project.link}
          github={project.github}
          tags={project.tags}
        />
      ))}
    </div>

    <div class="mt-16 text-center reveal reveal-delay-3">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 px-8 py-4 bg-slate-900 hover:bg-slate-800 text-white text-md font-semibold rounded-full transition-all duration-300 shadow-md hover:shadow-lg active:scale-95"
      >
        See All Projects
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
