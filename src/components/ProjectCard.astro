---
interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  github: string;
  tags: string[];
}

const { title, description, image, link, github, tags } = Astro.props;
---

<div class="group relative bg-white/[0.03] rounded-2xl overflow-hidden border border-white/[0.06] hover:border-brand-secondary/30 hover:shadow-xl hover:shadow-brand-secondary/5 transition-all duration-500 transform hover:-translate-y-2 flex flex-col h-full">
  <div class="relative h-56 overflow-hidden">
    <img
      src={image}
      alt={title}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/90 via-brand-dark/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5">
      <div class="flex gap-3">
        {link && (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-brand-secondary hover:bg-brand-secondary/80 text-white text-sm font-semibold rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-300 w-fit"
          >
            View demo
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        )}
        {github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-sm font-semibold rounded-full transform translate-y-4 group-hover:translate-y-0 transition-all duration-300 w-fit backdrop-blur-sm"
          >
            GitHub
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
              <path d="M9 18c-4.51 2-5-2-7-2"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
  <div class="p-6 flex-1 flex flex-col">
    <h3 class="text-xl font-bold text-white mb-3 group-hover:text-brand-secondary transition-colors">
      {title}
    </h3>
    <p class="text-slate-400 mb-5 flex-1 line-clamp-3 leading-relaxed text-sm">
      {description}
    </p>
    <div class="flex flex-wrap gap-2 mt-auto">
      {tags.map((tag) => (
        <span class="px-3 py-1 text-xs font-medium text-slate-400 bg-white/[0.04] border border-white/[0.08] rounded-lg group-hover:border-brand-secondary/30 group-hover:text-brand-secondary transition-colors">
          {tag}
        </span>
      ))}
    </div>
  </div>
</div>
