---
import Button from "./ui/Button.astro";
import Badge from "./ui/Badge.astro";
import Icon from "./ui/Icon.astro";
import { getLangFromUrl, useTranslations, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
  title: string;
  description: string;
  image: string;
  link: string;
  github: string;
  tags: string[];
}

const {
  lang = getLangFromUrl(Astro.url),
  title,
  description,
  image,
  link,
  github,
  tags,
}: Props = Astro.props;

const t = useTranslations(lang);
---

<div
  class="group relative bg-white/[0.03] rounded-2xl overflow-hidden border border-white/[0.06] hover:border-brand-secondary/30 hover:shadow-xl hover:shadow-brand-secondary/5 transition-all duration-500 transform hover:-translate-y-2 flex flex-col h-full"
>
  <div class="relative h-56 overflow-hidden">
    <img
      src={image}
      alt={title}
      width="800"
      height="450"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
    <!-- Hover overlay (desktop only) -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-brand-dark/90 via-brand-dark/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden xl:flex flex-col justify-end p-5"
    >
      <div class="flex gap-3">
        {
          link && (
            <Button
              href={link}
              variant="primary"
              size="sm"
              external={true}
              class="transform translate-y-4 group-hover:translate-y-0"
            >
              {t.projects.viewDemo}
              <Icon name="arrow-right" size={14} />
            </Button>
          )
        }
        {
          github && (
            <Button
              href={github}
              variant="secondary"
              size="sm"
              external={true}
              class="transform translate-y-4 group-hover:translate-y-0 backdrop-blur-sm"
            >
              {t.projects.github}
              <Icon name="github" size={14} />
            </Button>
          )
        }
      </div>
    </div>
  </div>

  <div class="p-6 flex-1 flex flex-col">
    <h3
      class="text-xl font-bold text-white mb-3 group-hover:text-brand-secondary transition-colors"
    >
      {title}
    </h3>
    <p class="text-slate-400 mb-5 flex-1 line-clamp-3 leading-relaxed text-sm">
      {description}
    </p>

    <!-- Buttons always visible on mobile/tablet -->
    <div class="flex gap-3 mb-4 xl:hidden">
      {
        link && (
          <Button href={link} variant="primary" size="sm" external={true}>
            {t.projects.demoShort}
            <Icon name="arrow-right" size={14} />
          </Button>
        )
      }
      {
        github && (
          <Button href={github} variant="secondary" size="sm" external={true}>
            {t.projects.github}
            <Icon name="github" size={14} />
          </Button>
        )
      }
    </div>

    <div class="flex flex-wrap gap-2 mt-auto">
      {
        tags.map((tag) => (
          <Badge
            variant="neutral"
            size="sm"
            class="group-hover:border-brand-secondary/30 group-hover:text-brand-secondary transition-colors"
          >
            {tag}
          </Badge>
        ))
      }
    </div>
  </div>
</div>
