---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projects from "../data/projects.json";
---

<Layout
  title="All Projects — Moralescr Tech"
  description="Explore all projects built by Adrián Morales."
>
  <main class="w-full flex-1">
    <Navbar />

    <div
      class="pt-28 pb-24 px-6 md:px-16 lg:px-24 xl:px-24 2xl:px-16 min-h-[80vh] bg-brand-dark relative overflow-hidden"
    >
      <div
        class="glow-orb absolute -top-40 -right-40 w-[500px] h-[500px] pointer-events-none"
        style="background: radial-gradient(circle, rgba(34,166,153,0.08) 0%, transparent 70%);"
      ></div>
      <div
        class="glow-orb absolute bottom-20 -left-20 w-[400px] h-[400px] pointer-events-none"
        style="background: radial-gradient(circle, rgba(242,76,61,0.06) 0%, transparent 70%);"
      ></div>

      <div class="max-w-[1400px] 2xl:max-w-[1536px] mx-auto relative z-10">
        <div class="mb-16 text-center">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-sm text-slate-400 hover:text-brand-secondary transition-colors mb-6"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path>
            </svg>
            Back to home
          </a>
          <h1
            class="text-4xl md:text-5xl font-extrabold text-white mb-4 tracking-tight"
          >
            All <span class="text-brand-secondary">Projects</span>
          </h1>
          <p class="text-slate-400 text-lg max-w-2xl mx-auto">
            List of all projects built by me, including web applications, landing pages, and websites.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            projects.map((project) => (
              <ProjectCard
                title={project.title}
                description={project.description}
                image={project.image}
                link={project.link}
                github={project.github}
                tags={project.tags}
              />
            ))
          }
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
